<Window x:Class="JumpzysVortex.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jumpzys Vortex"
        Icon="vortex.ico"
        Width="520" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- ── Glow pulse ── -->
        <Storyboard x:Key="GlowPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="GlowRect"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.7" Duration="0:0:1.4"
                             AutoReverse="True"
                             EasingFunction="{x:Null}"/>
        </Storyboard>

        <!-- ── Dot blink ── -->
        <Storyboard x:Key="DotBlink" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LiveDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.1" Duration="0:0:0.8"
                             AutoReverse="True"/>
        </Storyboard>

        <!-- ── Scan line ── -->
        <Storyboard x:Key="ScanAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ScanLine"
                             Storyboard.TargetProperty="(Canvas.Top)"
                             From="-4" To="320" Duration="0:0:2.5"
                             EasingFunction="{x:Null}"/>
        </Storyboard>

        <!-- ── Fade in ── -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="LogoPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.6"
                             BeginTime="0:0:0.2"/>
            <ThicknessAnimation Storyboard.TargetName="LogoPanel"
                                Storyboard.TargetProperty="Margin"
                                From="0,20,0,0" To="0,0,0,0"
                                Duration="0:0:0.5" BeginTime="0:0:0.2">
                <ThicknessAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>

    </Window.Resources>

    <!-- Root with drop shadow -->
    <Border x:Name="RootBorder" Opacity="0"
            Background="#050709"
            BorderBrush="#1A2030" BorderThickness="1"
            CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40"
                              ShadowDepth="0" Opacity="0.9"/>
        </Border.Effect>

        <Canvas ClipToBounds="True">

            <!-- ── Background hex grid (decorative) ── -->
            <Canvas.Background>
                <DrawingBrush TileMode="Tile"
                              Viewport="0,0,60,52" ViewportUnits="Absolute"
                              Opacity="0.04">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Transparent">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#00FF88" Thickness="0.6"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M30,1 L55,15 L55,41 L30,55 L5,41 L5,15 Z"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Canvas.Background>

            <!-- ── Green top glow ── -->
            <Rectangle x:Name="GlowRect"
                       Canvas.Left="0" Canvas.Top="0"
                       Width="520" Height="2" Opacity="0.4">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#00FF88"     Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ── Ambient left glow ── -->
            <Ellipse Canvas.Left="-80" Canvas.Top="60"
                     Width="240" Height="200" Opacity="0.06">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00FF88" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- ── Ambient right glow ── -->
            <Ellipse Canvas.Left="340" Canvas.Top="100"
                     Width="200" Height="180" Opacity="0.04">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00D4FF" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- ── Scan line ── -->
            <Rectangle x:Name="ScanLine"
                       Canvas.Left="0" Canvas.Top="-4"
                       Width="520" Height="2" Opacity="0.06">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#00FF88"     Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ── Main content ── -->
            <StackPanel x:Name="LogoPanel" Opacity="0"
                        Canvas.Left="0" Canvas.Top="0"
                        Width="520">

                <!-- Logo block -->
                <Grid Margin="52,48,52,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hex icon -->
                    <Canvas Width="52" Height="52" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Polygon Points="26,2 48,14 48,38 26,50 4,38 4,14"
                                 Stroke="#00FF88" StrokeThickness="1.5"
                                 Fill="Transparent" Opacity="0.5"/>
                        <Polygon Points="26,10 40,18 40,34 26,42 12,34 12,18"
                                 Stroke="#00FF88" StrokeThickness="0.8"
                                 Fill="#0800FF88" Opacity="0.8"/>
                        <Ellipse Canvas.Left="19" Canvas.Top="19"
                                 Width="14" Height="14"
                                 Fill="#00FF88" Opacity="0.95"/>
                        <Ellipse Canvas.Left="22" Canvas.Top="22"
                                 Width="8" Height="8"
                                 Fill="#00FF88"/>
                    </Canvas>

                    <!-- Text -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="JUMPZYS VORTEX"
                                   FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                   Foreground="#00FF88"
                                   />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="v2.2"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#4A5870"/>
                            <TextBlock Text="  ·  "
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#1A2030"/>
                            <TextBlock Text="GAME OPTIMISER"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#2A3A50"
                                       />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Divider -->
                <Rectangle Height="1" Margin="52,20,52,0" Opacity="0.15">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#00FF88"     Offset="0.3"/>
                            <GradientStop Color="#00FF88"     Offset="0.7"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Status lines -->
                <StackPanel Margin="52,16,52,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Live dot -->
                        <Ellipse x:Name="LiveDot" Width="5" Height="5"
                                 Fill="#00FF88" VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusLine" Grid.Column="1"
                                   Text="Initialising system..."
                                   FontFamily="Consolas" FontSize="10"
                                   Foreground="#3A5040"/>
                    </Grid>

                    <TextBlock x:Name="SubStatusLine"
                               Text=""
                               FontFamily="Consolas" FontSize="9"
                               Foreground="#1E2A20"
                               Margin="13,3,0,0"/>
                </StackPanel>

                <!-- Progress bar -->
                <Grid Margin="52,16,52,0">
                    <!-- Track -->
                    <Rectangle Height="3" Fill="#0D1117" RadiusX="1" RadiusY="1"/>
                    <!-- Fill -->
                    <Rectangle x:Name="ProgressFill"
                               Height="3" HorizontalAlignment="Left"
                               Width="0" RadiusX="1" RadiusY="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00CC6A" Offset="0"/>
                                <GradientStop Color="#00FF88" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <DropShadowEffect Color="#00FF88" BlurRadius="6"
                                             ShadowDepth="0" Opacity="0.6"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <!-- Tick marks -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Rectangle Width="1" Height="3" Fill="#1A2030"/>
                        <Rectangle Width="103" Height="1" Fill="Transparent"/>
                        <Rectangle Width="1" Height="3" Fill="#1A2030"/>
                        <Rectangle Width="103" Height="1" Fill="Transparent"/>
                        <Rectangle Width="1" Height="3" Fill="#1A2030"/>
                        <Rectangle Width="103" Height="1" Fill="Transparent"/>
                        <Rectangle Width="1" Height="3" Fill="#1A2030"/>
                        <Rectangle Width="103" Height="1" Fill="Transparent"/>
                        <Rectangle Width="1" Height="3" Fill="#1A2030"/>
                    </StackPanel>
                </Grid>

                <!-- Bottom row -->
                <Grid Margin="52,10,52,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PctLabel"
                               Text="0%"
                               FontFamily="Consolas" FontSize="9"
                               Foreground="#2A3A30"/>
                    <TextBlock Grid.Column="1"
                               Text="ML · HOTKEYS · NETWORK · OVERLAY"
                               FontFamily="Consolas" FontSize="8"
                               Foreground="#1A2020"
                               />
                </Grid>

            </StackPanel>

            <!-- Corner decoration top-right -->
            <Canvas Canvas.Right="0" Canvas.Top="0"
                    Canvas.Left="460" Width="60" Height="60">
                <Line X1="60" Y1="0" X2="60" Y2="20"
                      Stroke="#00FF88" StrokeThickness="1" Opacity="0.15"/>
                <Line X1="40" Y1="0" X2="60" Y2="0"
                      Stroke="#00FF88" StrokeThickness="1" Opacity="0.15"/>
            </Canvas>

            <!-- Corner decoration bottom-left -->
            <Canvas Canvas.Left="0" Canvas.Top="280">
                <Line X1="0" Y1="40" X2="0" Y2="20"
                      Stroke="#00FF88" StrokeThickness="1" Opacity="0.1"/>
                <Line X1="0" Y1="40" X2="20" Y2="40"
                      Stroke="#00FF88" StrokeThickness="1" Opacity="0.1"/>
            </Canvas>

        </Canvas>
    </Border>
</Window>
