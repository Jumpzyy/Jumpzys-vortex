<Application x:Class="JumpzysVortex.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        StartupUri is intentionally omitted.
        MainWindow is created programmatically in App.xaml.cs (standalone)
        or by TrayApp (tray entry point).
    -->
    <Application.Resources>

        <!-- ══ COLOURS ══════════════════════════════════════════════ -->
        <Color x:Key="BgColor">#FF050713</Color>
        <Color x:Key="Bg2Color">#FF070B18</Color>
        <Color x:Key="CardColor">#FF0B1220</Color>
        <Color x:Key="BorderColor">#FF223047</Color>
        <Color x:Key="Border2Color">#FF30405C</Color>
        <Color x:Key="GreenColor">#FF22E6A8</Color>
        <Color x:Key="BlueColor">#FF38BDF8</Color>
        <Color x:Key="PurpleColor">#FFE879F9</Color>
        <Color x:Key="YellowColor">#FFFBBF24</Color>
        <Color x:Key="RedColor">#FFFB7185</Color>
        <Color x:Key="TextColor">#FFF2F7FF</Color>
        <Color x:Key="MutedColor">#FF7C8AA5</Color>

        <SolidColorBrush x:Key="BgBrush"      Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="Bg2Brush"     Color="{StaticResource Bg2Color}"/>
        <SolidColorBrush x:Key="CardBrush"    Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="BorderBrush"  Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="Border2Brush" Color="{StaticResource Border2Color}"/>
        <SolidColorBrush x:Key="GreenBrush"   Color="{StaticResource GreenColor}"/>
        <SolidColorBrush x:Key="BlueBrush"    Color="{StaticResource BlueColor}"/>
        <SolidColorBrush x:Key="PurpleBrush"  Color="{StaticResource PurpleColor}"/>
        <SolidColorBrush x:Key="YellowBrush"  Color="{StaticResource YellowColor}"/>
        <SolidColorBrush x:Key="RedBrush"     Color="{StaticResource RedColor}"/>
        <SolidColorBrush x:Key="TextBrush"    Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="MutedBrush"   Color="{StaticResource MutedColor}"/>

        <!-- ══ CARD ══════════════════════════════════════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="Padding"         Value="12,10"/>
        </Style>

        <!-- ══ SECTION LABEL ═════════════════════════════════════════ -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <!-- ══ BIG VALUE ═════════════════════════════════════════════ -->
        <Style x:Key="BigVal" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="22"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Foreground"  Value="{StaticResource GreenBrush}"/>
        </Style>

        <!-- ══ SLIM PROGRESS BAR ═════════════════════════════════════ -->
        <Style x:Key="SlimBar" TargetType="ProgressBar">
            <Setter Property="Height"          Value="3"/>
            <Setter Property="Maximum"         Value="100"/>
            <Setter Property="Background"      Value="#192235"/>
            <Setter Property="Foreground"      Value="{StaticResource GreenBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin"          Value="0,5,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="1"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ BOOST BUTTON ══════════════════════════════════════════ -->
        <Style x:Key="BoostButton" TargetType="Button">
            <Setter Property="Background"      Value="#1238BDF8"/>
            <Setter Property="Foreground"      Value="{StaticResource BlueBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BlueBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="0,13"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2238BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3038BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ SECONDARY BUTTON ══════════════════════════════════════ -->
        <Style x:Key="SecButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border2Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="0,9"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ SMALL BUTTON ══════════════════════════════════════════ -->
        <Style x:Key="SmButton" TargetType="Button">
            <Setter Property="Background"      Value="#1422E6A8"/>
            <Setter Property="Foreground"      Value="{StaticResource GreenBrush}"/>
            <Setter Property="BorderBrush"     Value="#5522E6A8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="9"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2422E6A8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ TOGGLE CHECKBOX ═══════════════════════════════════════ -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#7080A0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="30" Height="15"
                                    Background="#0FFFFFFF"
                                    BorderBrush="{StaticResource Border2Brush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border x:Name="Thumb" Width="9" Height="9"
                                        Background="{StaticResource MutedBrush}"
                                        CornerRadius="5"
                                        HorizontalAlignment="Left"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"          Value="#2422E6A8"/>
                                <Setter TargetName="Track" Property="BorderBrush"         Value="#8822E6A8"/>
                                <Setter TargetName="Thumb" Property="Background"          Value="{StaticResource GreenBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin"              Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ NAV TAB RADIO BUTTON ══════════════════════════════════ -->
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ KEY CHIP ══════════════════════════════════════════════ -->
        <Style x:Key="KeyChip" TargetType="Border">
            <Setter Property="Background"      Value="#0A0E14"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border2Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="2"/>
            <Setter Property="Padding"         Value="5,2"/>
        </Style>

        <!-- ══ DARK TEXT INPUT ════════════════════════════════════════ -->
        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background"      Value="#06080F"/>
            <Setter Property="Foreground"      Value="#8090A8"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,5"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="CaretBrush"      Value="{StaticResource GreenBrush}"/>
        </Style>

        <!-- ══ SCROLLBAR ═════════════════════════════════════════════ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

    </Application.Resources>
</Application>
