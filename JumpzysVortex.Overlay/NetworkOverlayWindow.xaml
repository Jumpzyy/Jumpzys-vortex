<Window x:Class="JumpzysVortex.Overlay.NetworkOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vortex Net Overlay"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        IsHitTestVisible="False"
        Width="160" Height="70"
        Left="16" Top="112"
        ResizeMode="NoResize">

    <Border Background="#CC080A0D"
            BorderBrush="#3300D4FF" BorderThickness="1"
            CornerRadius="3" Padding="10,8">
        <Border.Effect>
            <DropShadowEffect Color="#00D4FF" BlurRadius="8" ShadowDepth="0" Opacity=".25"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="NETWORK" FontFamily="Consolas" FontSize="8"
                       Foreground="#4A5870" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PING" FontFamily="Consolas" FontSize="8" Foreground="#4A5870"/>
                    <TextBlock x:Name="PingText" Text="— ms"
                               FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                               Foreground="#00D4FF"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="JITTER" FontFamily="Consolas" FontSize="8" Foreground="#4A5870"/>
                    <TextBlock x:Name="JitterText" Text="— ms"
                               FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                               Foreground="#00D4FF"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
