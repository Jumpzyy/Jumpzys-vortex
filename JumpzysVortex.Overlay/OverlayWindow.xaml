<Window x:Class="JumpzysVortex.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vortex Overlay"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        IsHitTestVisible="False"
        Width="180" Height="90"
        Left="16" Top="16"
        ResizeMode="NoResize">

    <Border Background="#CC080A0D"
            BorderBrush="#3300FF88" BorderThickness="1"
            CornerRadius="3" Padding="10,8">

        <!-- Top green glow line -->
        <Border.Effect>
            <DropShadowEffect Color="#00FF88" BlurRadius="10" ShadowDepth="0" Opacity=".3"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <TextBlock Text="VORTEX" FontFamily="Consolas" FontSize="8"
                       Foreground="#4A5870" Margin="0,0,0,4"/>

            <!-- Metrics row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- FPS -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="FPS" FontFamily="Consolas" FontSize="8" Foreground="#4A5870"/>
                    <TextBlock x:Name="FpsText" Text="—"
                               FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                               Foreground="#00FF88"/>
                </StackPanel>

                <!-- CPU -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CPU" FontFamily="Consolas" FontSize="8" Foreground="#4A5870"/>
                    <TextBlock x:Name="CpuText" Text="—%"
                               FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                               Foreground="#00FF88"/>
                </StackPanel>

                <!-- STATE -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="STATE" FontFamily="Consolas" FontSize="8" Foreground="#4A5870"/>
                    <TextBlock x:Name="StateText" Text="●"
                               FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                               Foreground="#00FF88"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
